[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/Combate.gd" id="1"]

[node name="Combate" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.12, 0.02, 0.02, 1)

[node name="Margem" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="Margem"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="TopBar" type="HBoxContainer" parent="Margem/VBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="EnemyName" type="Label" parent="Margem/VBox/TopBar"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 20
text = "Inimigo"

[node name="EnemyHpBar" type="ProgressBar" parent="Margem/VBox/TopBar"]
custom_minimum_size = Vector2(220, 22)
layout_mode = 2
show_percentage = false

[node name="PlayerHpBar" type="ProgressBar" parent="Margem/VBox/TopBar"]
custom_minimum_size = Vector2(220, 22)
layout_mode = 2
show_percentage = false

[node name="PlayerHpLabel" type="Label" parent="Margem/VBox/TopBar"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
text = "❤ 100/100"

[node name="CoinsLabel" type="Label" parent="Margem/VBox/TopBar"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.9, 0.4, 1)
text = "Moedas: 0"

[node name="DiceArea" type="HBoxContainer" parent="Margem/VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 24
custom_minimum_size = Vector2(0, 160)

[node name="FeedbackLabel" type="Label" parent="Margem/VBox"]
layout_mode = 2
horizontal_alignment = 1
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 20
text = "Faça sua aposta!"

[node name="BetOptions" type="HBoxContainer" parent="Margem/VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 10

[node name="RollButton" type="Button" parent="Margem/VBox"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
disabled = true
text = "🎲 Rolar"

[connection signal="pressed" from="Margem/VBox/RollButton" to="." method="_on_roll_button_pressed"]
